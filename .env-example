# This file contains default values for environment values that are needed either by Docker Compose itself
# or by the docker compose files.

# COMPOSE_PROJECT_NAME declares the prefix of the name of the Docker containers. So if the
# project name is 'acme_support' then the web container is named either 'acme_support_web_1' for
# Compose V1 or 'acme_support-web-1 for Compose V2. The project name also declares
# the prefix of named volumes. Thus changing the project name allows to have
# separate containers and volumes for separate installations.
#
# Note that when COMPOSE_PROJECT_NAME is set in the shell environment,
# then that setting has higher precedence.
COMPOSE_PROJECT_NAME=otobo-ai

# COMPOSE_FILE is a collection of files, separated by COMPOSE_PATH_SEPARATOR, that make up the final config.
# These files usually reside in the subdirectory docker-compose.
# Additional services can be added by concatenating more files to COMPOSE_FILE.
COMPOSE_PATH_SEPARATOR=:

# if you run the OTOBO docker compose stack and want to use its mariadb for the ai-service
COMPOSE_FILE=docker-compose/otobo-ai_base.yml:docker-compose/otobo-ai_otobo-docker.yml
#
# if you run the OTOBO docker compose stack and want to maintain an independant mariadb for the ai-service (schema pre-applied)
# COMPOSE_FILE=docker-compose/otobo-ai_base.yml:docker-compose/otobo-ai_otobo-docker.yml:docker-compose/otobo-ai_db.yml
#
# if you run an independent setup (OTOBO native installation) and want to use its mariadb for the ai-service
# COMPOSE_FILE=docker-compose/otobo-ai_base.yml:docker-compose/otobo-ai_standalone.yml
#
# if you run an independent setup (OTOBO native installation) and want to maintain an independant mariadb for the ai-service (schema pre-applied)
# COMPOSE_FILE=docker-compose/otobo-ai_base.yml:docker-compose/otobo-ai_standalone.yml:docker-compose/otobo-ai_db.yml
#
# for development, expectes mariadb provided by OTOBO docker compose stack
# COMPOSE_FILE=docker-compose/otobo-ai_base.yml:docker-compose/otobo-ai_otobo-docker.yml:docker-compose/otobo-ai_dev.yml

# docker-compose/otobo-ai_openwebui.yml
# Optional: Adds a chat interface to the stack.

# docker-compose/otobo-ai_mcp.yml
# Optional: Adds a MCP server to the stack.


# RAG
################################

# Image version for downstream updates
# See: https://hub.docker.com/r/rotheross/otobo-ai-services
# OTOBO_AI_IMAGE_VERSION=rel-1_0

# Token to auth this API, generate via `openssl rand -hex 32`
OTOBO_AI_API_KEY=CHANGEME

# Optional, Ip address of this server inside the docker, default is "0.0.0.0"
OTOBO_AI_HOST=0.0.0.0

# Optional: port of this server
OTOBO_AI_PORT=8000

# Parameters for Vector Database
OTOBO_AI_CHROMA_DIR=/chroma

# chunk size in characters
# larger size give more context but cost more tokens
# and are less specific
#
# remark: the example rag compiles 11 chunks
# together with request and system prompt you
# should stay below 80% of your models context window size
OTOBO_AI_EMBEDDING_CHUNK_SIZE=2000
OTOBO_AI_EMBEDDING_CHUNK_OVERLAP=200

# Parameters for language models
# Optional: token to auth the llm server
OTOBO_AI_LLM_API_KEY="api-key-to-the-llm-server"

# URL of OpenAI API compatible LLM server
OTOBO_AI_LLM_HOST=http://myollama:11434

# Optional: llama llm model, default is llama2:13b-chat
OTOBO_AI_LLM_MODEL=qwen3:30b-instruct
OTOBO_AI_LLM_EVAL_MODEL=qwen3:30b-instruct

# Optional: embedding model, default is bge-m3
### WARNING ###
# Changing the embedding model requires a re-import of all data
OTOBO_AI_EMBEDDING_MODEL=qwen3-embedding:4b

# Optional: temperature (see llama doc), default is 0.1
# OTOBO_AI_LLM_TEMPERATURE=0.1
# OTOBO_AI_LLM_EVAL_TEMPERATURE=0.1

# Parameters for LANGFUSE
# Optional: Keys for debugging
LANGFUSE_SECRET_KEY=""
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_BASE_URL=""

# OTOBO_AI_LOG_FILE
# OTOBO_AI_LOG_LEVEL

# Parameters for MariaDB
OTOBO_AI_DB_HOST=mariadb
OTOBO_AI_DB_PORT=3306
OTOBO_AI_DB_NAME=db_name
OTOBO_AI_DB_USER=otobo_ai
OTOBO_AI_DB_PW=mariadbpw


# CHAT
############################################
# Source: https://docs.openwebui.com/reference/env-configuration/

# Image version for downstream updates
# See: https://hub.docker.com/r/openwebui/open-webui
# OPENWEBUI_IMAGE_VERSION=0.12.4-slim

# The chat is provided by docker-compose/otobo-ai_chat.yml
# To add the container to the stack you need to append it to
# the COMPOSE_FILE on the top of this file.

# The first user is the admin
# It may be used to setup user accounts
WEBUI_ADMIN_EMAIL=""
# maybe: openssl rand -hex 16
WEBUI_ADMIN_PASSWORD=""

# Open WebUI can to me served under a path,
# we need to use a port (9000):
# https://github.com/open-webui/open-webui/discussions/6650
WEBUI_URL="https://fqdn:9000/"

# If you are setting up an auth provider like
# ENABLE_SIGNUP=True

# The browser setting and prompt are doing the
# majority of the heavy lifting.
# DEFAULT_LOCALE=de
# DEFAULT_LOCALE=en

TOOL_SERVER_CONNECTIONS='[{"type":"mcp","url":"http://mcp:8765/mcp","auth_type":"none","key":"","config":{"enable":true},"info":{"id":"otobo","name":"OTOBO","description":"The OTOBO MCP Server."}}]'

# MCP
##################################################
# https://github.com/RotherOSS/otobo-ai-mcp

# See: https://hub.docker.com/r/rotheross/otobo-ai-mcp
# OTOBO_MCP_IMAGE_VERSION=rel-1_0

# Where is the agent interface of your OTOBO reachable?
# This value is used to generate deep links to tickets in the chat interface
OTOBO_MCP_PUBLIC_URL=https://localhost/otobo/index.pl

